DECLARE @SQL VARCHAR(MAX);

SELECT @SQL =
    STRING_AGG(
        CAST(
            'SELECT ' +
            '''' + TABLE_SCHEMA + '.' + TABLE_NAME + ''' AS TABLE_NAME, ' +
            'COUNT_BIG(*) AS ROW_COUNT ' +
            'FROM PROD.' +
            QUOTENAME(TABLE_SCHEMA) + '.' +
            QUOTENAME(TABLE_NAME) +
            CASE
                WHEN NULLIF(LTRIM(RTRIM(CONDITION)), '') IS NOT NULL
                THEN ' WHERE ' + CONDITION
                ELSE ''
            END
            AS VARCHAR(MAX)
        ),
        ' UNION ALL '
    )
FROM dbo.TABLE_INVENTORY
WHERE ALIAS_VALUE = 'A';

-- Review generated SQL
SELECT @SQL AS GENERATED_SQL;

-- Execute
EXEC (@SQL);
