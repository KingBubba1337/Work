/*==============================================================
  1. PARAMETERS
==============================================================*/

DECLARE
    @ENTITY             VARCHAR(10)  = 'WCM',
    @SourceSchema       NVARCHAR(128) = 'dbo_storage',
    @SourceTable        NVARCHAR(128) = 'CLARITY_EMP',
    @DestinationSchema  NVARCHAR(128) = 'dbo';

DECLARE
    @DestinationTable   NVARCHAR(128),
    @ResultTableName    VARCHAR(128),
    @ResultTableFull    VARCHAR(300),
    @SQL                VARCHAR(MAX) = '';


SET @DestinationTable = @SourceTable;

-- Build dynamic metadata table name
SET @ResultTableName =
    'DOWNSTREAM_CREATE_TABLE_'
    + @ENTITY
    + '_'
    + CAST(@SourceTable AS VARCHAR(128));

-- Fully qualified result table name
SET @ResultTableFull =
    'PROD_CUSTOM.DBO.'
    + QUOTENAME(@ResultTableName);


/*==============================================================
  2. VALIDATE SOURCE TABLE
==============================================================*/

IF NOT EXISTS
(
    SELECT 1
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = @SourceSchema
      AND TABLE_NAME = @SourceTable
)
BEGIN

    SELECT
        'ERROR' AS Status,
        'Source table was not found or metadata is inaccessible.'
            AS Message;

    RETURN;

END;


/*==============================================================
  3. CHECK FOR UNSUPPORTED DATA TYPES
==============================================================*/

DECLARE @HasUnsupportedTypes INT;

SELECT
    @HasUnsupportedTypes = COUNT(*)
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = @SourceSchema
  AND TABLE_NAME = @SourceTable
  AND LOWER(DATA_TYPE) NOT IN
  (
      'bigint',
      'int',
      'smallint',
      'tinyint',
      'bit',
      'decimal',
      'numeric',
      'money',
      'smallmoney',
      'float',
      'real',
      'date',
      'datetime',
      'datetime2',
      'smalldatetime',
      'datetimeoffset',
      'time',
      'varchar',
      'nvarchar',
      'char',
      'nchar',
      'varbinary',
      'binary',
      'uniqueidentifier',
      'timestamp',
      'rowversion'
  );


IF @HasUnsupportedTypes > 0
BEGIN

    SELECT
        COLUMN_NAME,
        DATA_TYPE,
        'Unsupported data type' AS Issue
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = @SourceSchema
      AND TABLE_NAME = @SourceTable
      AND LOWER(DATA_TYPE) NOT IN
      (
          'bigint',
          'int',
          'smallint',
          'tinyint',
          'bit',
          'decimal',
          'numeric',
          'money',
          'smallmoney',
          'float',
          'real',
          'date',
          'datetime',
          'datetime2',
          'smalldatetime',
          'datetimeoffset',
          'time',
          'varchar',
          'nvarchar',
          'char',
          'nchar',
          'varbinary',
          'binary',
          'uniqueidentifier',
          'timestamp',
          'rowversion'
      );

    RETURN;

END;


/*==============================================================
  4. GENERATE DESTINATION COLUMN DEFINITIONS
==============================================================*/

DECLARE @ColumnDDL NVARCHAR(MAX);

SELECT
    @ColumnDDL =
        STRING_AGG
        (
            CAST
            (
                QUOTENAME(COLUMN_NAME)
                + ' '
                +
                CASE LOWER(DATA_TYPE)

                    /* Integer types */

                    WHEN 'bigint' THEN 'BIGINT'
                    WHEN 'int' THEN 'INT'
                    WHEN 'smallint' THEN 'SMALLINT'
                    WHEN 'tinyint' THEN 'TINYINT'
                    WHEN 'bit' THEN 'BIT'


                    /* Decimal */

                    WHEN 'decimal' THEN
                        'DECIMAL('
                        + CAST(NUMERIC_PRECISION AS VARCHAR(10))
                        + ','
                        + CAST(NUMERIC_SCALE AS VARCHAR(10))
                        + ')'

                    WHEN 'numeric' THEN
                        'NUMERIC('
                        + CAST(NUMERIC_PRECISION AS VARCHAR(10))
                        + ','
                        + CAST(NUMERIC_SCALE AS VARCHAR(10))
                        + ')'


                    /* Monetary */

                    WHEN 'money' THEN 'MONEY'
                    WHEN 'smallmoney' THEN 'SMALLMONEY'


                    /* Floating point */

                    WHEN 'float' THEN 'FLOAT'
                    WHEN 'real' THEN 'REAL'


                    /* Date/time */

                    WHEN 'date' THEN 'DATE'
                    WHEN 'datetime' THEN 'DATETIME'
                    WHEN 'smalldatetime' THEN 'SMALLDATETIME'

                    WHEN 'datetime2' THEN
                        'DATETIME2('
                        + CAST(DATETIME_PRECISION AS VARCHAR(10))
                        + ')'

                    WHEN 'datetimeoffset' THEN
                        'DATETIMEOFFSET('
                        + CAST(DATETIME_PRECISION AS VARCHAR(10))
                        + ')'

                    WHEN 'time' THEN
                        'TIME('
                        + CAST(DATETIME_PRECISION AS VARCHAR(10))
                        + ')'


                    /* Character types */

                    WHEN 'varchar' THEN
                        CASE
                            WHEN CHARACTER_MAXIMUM_LENGTH = -1
                                THEN 'VARCHAR(MAX)'
                            ELSE
                                'VARCHAR('
                                + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                                + ')'
                        END

                    WHEN 'nvarchar' THEN
                        CASE
                            WHEN CHARACTER_MAXIMUM_LENGTH = -1
                                THEN 'NVARCHAR(MAX)'
                            ELSE
                                'NVARCHAR('
                                + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                                + ')'
                        END

                    WHEN 'char' THEN
                        'CHAR('
                        + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                        + ')'

                    WHEN 'nchar' THEN
                        'NCHAR('
                        + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                        + ')'


                    /* Binary types */

                    WHEN 'varbinary' THEN
                        CASE
                            WHEN CHARACTER_MAXIMUM_LENGTH = -1
                                THEN 'VARBINARY(MAX)'
                            ELSE
                                'VARBINARY('
                                + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                                + ')'
                        END

                    WHEN 'binary' THEN
                        'BINARY('
                        + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                        + ')'


                    /* GUID */

                    WHEN 'uniqueidentifier' THEN 'UNIQUEIDENTIFIER'


                    /* Timestamp/rowversion */

                    WHEN 'timestamp' THEN 'BINARY(8)'
                    WHEN 'rowversion' THEN 'BINARY(8)'

                END
                + ' NULL'

                AS NVARCHAR(MAX)
            ),

            ',' + CHAR(13) + CHAR(10) + '    '

        )
        WITHIN GROUP (ORDER BY ORDINAL_POSITION)

FROM INFORMATION_SCHEMA.COLUMNS

WHERE TABLE_SCHEMA = @SourceSchema
  AND TABLE_NAME = @SourceTable;


/*==============================================================
  5. VALIDATE GENERATED COLUMN DEFINITIONS
==============================================================*/

IF @ColumnDDL IS NULL OR LEN(@ColumnDDL) = 0
BEGIN

    SELECT
        'ERROR' AS Status,
        'Unable to generate column definitions.' AS Message;

    RETURN;

END;


/*==============================================================
  6. GENERATE FINAL CREATE TABLE STATEMENT
==============================================================*/

DECLARE @CreateTableSQL NVARCHAR(MAX);

SET @CreateTableSQL =

    'IF OBJECT_ID(N'''
    + REPLACE
      (
          QUOTENAME(@DestinationSchema)
          + '.'
          + QUOTENAME(@DestinationTable),
          '''',
          ''''''
      )
    + ''', N''U'') IS NULL'

    + CHAR(13) + CHAR(10)

    + 'BEGIN'

    + CHAR(13) + CHAR(10)

    + '    CREATE TABLE '
    + QUOTENAME(@DestinationSchema)
    + '.'
    + QUOTENAME(@DestinationTable)

    + ' ('

    + CHAR(13) + CHAR(10)

    + '    '
    + @ColumnDDL

    + CHAR(13) + CHAR(10)

    + '    );'

    + CHAR(13) + CHAR(10)

    + 'END;';


/*==============================================================
  7. DROP EXISTING RESULT TABLE
==============================================================*/

SET @SQL =

    'IF EXISTS
    (
        SELECT 1
        FROM PROD_CUSTOM.SYS.TABLES
        WHERE NAME = '''
        + REPLACE(@ResultTableName, '''', '''''')
        + '''
    )
    BEGIN
        DROP TABLE '
        + @ResultTableFull
        + ';
    END;';

EXEC(@SQL);


/*==============================================================
  8. CREATE RESULT TABLE
==============================================================*/

SET @SQL =

    'CREATE TABLE '
    + @ResultTableFull
    + '
    (
        Status              VARCHAR(20)  NOT NULL,
        SourceSchema        VARCHAR(128) NOT NULL,
        SourceTable         VARCHAR(128) NOT NULL,
        DestinationSchema   VARCHAR(128) NOT NULL,
        DestinationTable    VARCHAR(128) NOT NULL,
        ColumnCount         INT          NOT NULL,
        CreateTableSQL      VARCHAR(MAX) NOT NULL
    );';

EXEC(@SQL);


/*==============================================================
  9. INSERT GENERATED SQL INTO DYNAMIC RESULT TABLE
==============================================================*/

DECLARE @InsertSQL VARCHAR(MAX);

SET @InsertSQL =

    'INSERT INTO '
    + @ResultTableFull
    + '
    (
        Status,
        SourceSchema,
        SourceTable,
        DestinationSchema,
        DestinationTable,
        ColumnCount,
        CreateTableSQL
    )
    VALUES
    (
        ''SUCCESS'',
        @pSourceSchema,
        @pSourceTable,
        @pDestinationSchema,
        @pDestinationTable,
        @pColumnCount,
        @pCreateTableSQL
    );';


DECLARE @ColumnCount INT;

SELECT
    @ColumnCount = COUNT(*)
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = @SourceSchema
  AND TABLE_NAME = @SourceTable;


/* Parameterized insert */

EXEC sp_executesql
    @InsertSQL,
    N'
        @pSourceSchema VARCHAR(128),
        @pSourceTable VARCHAR(128),
        @pDestinationSchema VARCHAR(128),
        @pDestinationTable VARCHAR(128),
        @pColumnCount INT,
        @pCreateTableSQL NVARCHAR(MAX)
    ',
    @pSourceSchema = @SourceSchema,
    @pSourceTable = @SourceTable,
    @pDestinationSchema = @DestinationSchema,
    @pDestinationTable = @DestinationTable,
    @pColumnCount = @ColumnCount,
    @pCreateTableSQL = @CreateTableSQL;


/*==============================================================
  10. RETURN RESULT
==============================================================*/

SET @SQL =
    'SELECT * FROM '
    + @ResultTableFull
    + ';';

EXEC(@SQL);
