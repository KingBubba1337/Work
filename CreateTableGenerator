/*================================================================
  SYNAPSE SQL -> SQL SERVER CREATE TABLE GENERATOR

  PURPOSE:
      Generate SQL Server CREATE TABLE DDL based on a source
      Synapse SQL table.

  OUTPUT:
      A SQL Server-compatible CREATE TABLE statement.

  DESIGN:
      1. Reads source table metadata.
      2. Maps source data types to SQL Server data types.
      3. Preserves column order.
      4. Preserves string lengths.
      5. Preserves decimal precision and scale.
      6. Makes all destination columns nullable.
      7. Converts ROWVERSION/TIMESTAMP to BINARY(8).
      8. Reports unsupported data types.
      9. Generates CREATE TABLE only if the table does not exist.

  IMPORTANT:
      Run this query in the Synapse database containing the
      source table.

      Execute the returned CREATE TABLE statement against the
      destination SQL Server database.
================================================================*/


/*================================================================
  1. CONFIGURATION
================================================================*/

DECLARE @SourceSchema NVARCHAR(128) = 'dbo';
DECLARE @SourceTable NVARCHAR(128) = 'YourSourceTable';

DECLARE @DestinationSchema NVARCHAR(128) = 'dbo';
DECLARE @DestinationTable NVARCHAR(128) = 'YourDestinationTable';


/*================================================================
  2. IDENTIFY SOURCE TABLE
================================================================*/

DECLARE @SourceObjectID INT;

SET @SourceObjectID =
    OBJECT_ID(
        QUOTENAME(@SourceSchema)
        + N'.'
        + QUOTENAME(@SourceTable)
    );


IF @SourceObjectID IS NULL
BEGIN

    SELECT
        'ERROR' AS Status,
        'Source table was not found or metadata is inaccessible.'
            AS Message,
        @SourceSchema AS SourceSchema,
        @SourceTable AS SourceTable;

    RETURN;

END;


/*================================================================
  3. CREATE COLUMN METADATA TABLE
================================================================*/

DECLARE @ColumnDefinitions TABLE
(
    ColumnID INT,
    ColumnName NVARCHAR(128),
    SourceType NVARCHAR(128),
    DestinationType NVARCHAR(500),
    IsSupported INT,
    Issue NVARCHAR(1000)
);


/*================================================================
  4. READ SOURCE COLUMN METADATA AND MAP DATA TYPES
================================================================*/

INSERT INTO @ColumnDefinitions
(
    ColumnID,
    ColumnName,
    SourceType,
    DestinationType,
    IsSupported,
    Issue
)

SELECT

    c.column_id,

    c.name,

    TYPE_NAME(c.system_type_id) AS SourceType,


    /*------------------------------------------------------------
      DESTINATION DATA TYPE MAPPING
    ------------------------------------------------------------*/

    CASE

        /* INTEGER TYPES */

        WHEN TYPE_NAME(c.system_type_id) = 'bigint'
            THEN 'BIGINT'

        WHEN TYPE_NAME(c.system_type_id) = 'int'
            THEN 'INT'

        WHEN TYPE_NAME(c.system_type_id) = 'smallint'
            THEN 'SMALLINT'

        WHEN TYPE_NAME(c.system_type_id) = 'tinyint'
            THEN 'TINYINT'

        WHEN TYPE_NAME(c.system_type_id) = 'bit'
            THEN 'BIT'


        /* DECIMAL / NUMERIC */

        WHEN TYPE_NAME(c.system_type_id) IN ('decimal', 'numeric')
             AND c.precision BETWEEN 1 AND 38
             AND c.scale <= c.precision

            THEN
                'DECIMAL('
                + CAST(c.precision AS VARCHAR(10))
                + ','
                + CAST(c.scale AS VARCHAR(10))
                + ')'


        /* MONEY */

        WHEN TYPE_NAME(c.system_type_id) = 'money'
            THEN 'MONEY'

        WHEN TYPE_NAME(c.system_type_id) = 'smallmoney'
            THEN 'SMALLMONEY'


        /* FLOATING POINT */

        WHEN TYPE_NAME(c.system_type_id) = 'float'
            THEN 'FLOAT'

        WHEN TYPE_NAME(c.system_type_id) = 'real'
            THEN 'REAL'


        /* DATE AND TIME */

        WHEN TYPE_NAME(c.system_type_id) = 'date'
            THEN 'DATE'

        WHEN TYPE_NAME(c.system_type_id) = 'datetime'
            THEN 'DATETIME'

        WHEN TYPE_NAME(c.system_type_id) = 'smalldatetime'
            THEN 'SMALLDATETIME'

        WHEN TYPE_NAME(c.system_type_id) = 'datetime2'
            THEN
                'DATETIME2('
                + CAST(c.scale AS VARCHAR(10))
                + ')'

        WHEN TYPE_NAME(c.system_type_id) = 'datetimeoffset'
            THEN
                'DATETIMEOFFSET('
                + CAST(c.scale AS VARCHAR(10))
                + ')'

        WHEN TYPE_NAME(c.system_type_id) = 'time'
            THEN
                'TIME('
                + CAST(c.scale AS VARCHAR(10))
                + ')'


        /* VARCHAR */

        WHEN TYPE_NAME(c.system_type_id) = 'varchar'
             AND c.max_length = -1
            THEN 'VARCHAR(MAX)'

        WHEN TYPE_NAME(c.system_type_id) = 'varchar'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'VARCHAR('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'


        /* NVARCHAR */

        WHEN TYPE_NAME(c.system_type_id) = 'nvarchar'
             AND c.max_length = -1
            THEN 'NVARCHAR(MAX)'

        WHEN TYPE_NAME(c.system_type_id) = 'nvarchar'
             AND c.max_length BETWEEN 2 AND 8000
            THEN
                'NVARCHAR('
                + CAST(c.max_length / 2 AS VARCHAR(10))
                + ')'


        /* CHAR */

        WHEN TYPE_NAME(c.system_type_id) = 'char'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'CHAR('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'


        /* NCHAR */

        WHEN TYPE_NAME(c.system_type_id) = 'nchar'
             AND c.max_length BETWEEN 2 AND 8000
            THEN
                'NCHAR('
                + CAST(c.max_length / 2 AS VARCHAR(10))
                + ')'


        /* VARBINARY */

        WHEN TYPE_NAME(c.system_type_id) = 'varbinary'
             AND c.max_length = -1
            THEN 'VARBINARY(MAX)'

        WHEN TYPE_NAME(c.system_type_id) = 'varbinary'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'VARBINARY('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'


        /* BINARY */

        WHEN TYPE_NAME(c.system_type_id) = 'binary'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'BINARY('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'


        /* UNIQUEIDENTIFIER */

        WHEN TYPE_NAME(c.system_type_id) = 'uniqueidentifier'
            THEN 'UNIQUEIDENTIFIER'


        /* TIMESTAMP / ROWVERSION */

        WHEN TYPE_NAME(c.system_type_id) IN ('timestamp', 'rowversion')
            THEN 'BINARY(8)'


        /* UNSUPPORTED */

        ELSE NULL

    END AS DestinationType,


    /*------------------------------------------------------------
      VALIDATION
    ------------------------------------------------------------*/

    CASE

        WHEN TYPE_NAME(c.system_type_id) IN
        (
            'bigint',
            'int',
            'smallint',
            'tinyint',
            'bit',
            'decimal',
            'numeric',
            'money',
            'smallmoney',
            'float',
            'real',
            'date',
            'datetime',
            'smalldatetime',
            'datetime2',
            'datetimeoffset',
            'time',
            'varchar',
            'nvarchar',
            'char',
            'nchar',
            'varbinary',
            'binary',
            'uniqueidentifier',
            'timestamp',
            'rowversion'
        )

        AND NOT
        (
            TYPE_NAME(c.system_type_id) IN ('decimal', 'numeric')
            AND
            (
                c.precision NOT BETWEEN 1 AND 38
                OR c.scale > c.precision
            )
        )

        AND NOT
        (
            TYPE_NAME(c.system_type_id) IN
            (
                'varchar',
                'char',
                'varbinary',
                'binary'
            )
            AND c.max_length NOT BETWEEN 1 AND 8000
            AND c.max_length <> -1
        )

        AND NOT
        (
            TYPE_NAME(c.system_type_id) IN ('nvarchar', 'nchar')
            AND c.max_length NOT BETWEEN 2 AND 8000
            AND c.max_length <> -1
        )

        THEN 1

        ELSE 0

    END AS IsSupported,


    /*------------------------------------------------------------
      VALIDATION ERROR MESSAGE
    ------------------------------------------------------------*/

    CASE

        WHEN TYPE_NAME(c.system_type_id) NOT IN
        (
            'bigint',
            'int',
            'smallint',
            'tinyint',
            'bit',
            'decimal',
            'numeric',
            'money',
            'smallmoney',
            'float',
            'real',
            'date',
            'datetime',
            'smalldatetime',
            'datetime2',
            'datetimeoffset',
            'time',
            'varchar',
            'nvarchar',
            'char',
            'nchar',
            'varbinary',
            'binary',
            'uniqueidentifier',
            'timestamp',
            'rowversion'
        )

            THEN 'Unsupported source data type.'


        WHEN TYPE_NAME(c.system_type_id) IN ('decimal', 'numeric')
             AND
             (
                 c.precision NOT BETWEEN 1 AND 38
                 OR c.scale > c.precision
             )

            THEN 'Invalid decimal precision or scale.'


        WHEN TYPE_NAME(c.system_type_id) IN
        (
            'varchar',
            'char',
            'varbinary',
            'binary'
        )
        AND c.max_length NOT BETWEEN 1 AND 8000
        AND c.max_length <> -1

            THEN 'Invalid or unsupported binary/character length.'


        WHEN TYPE_NAME(c.system_type_id) IN ('nvarchar', 'nchar')
        AND c.max_length NOT BETWEEN 2 AND 8000
        AND c.max_length <> -1

            THEN 'Invalid or unsupported Unicode character length.'


        ELSE NULL

    END AS Issue


FROM sys.columns c

WHERE c.object_id = @SourceObjectID;


/*================================================================
  5. VALIDATE SOURCE COLUMNS
================================================================*/

IF NOT EXISTS
(
    SELECT 1
    FROM @ColumnDefinitions
)
BEGIN

    SELECT
        'ERROR' AS Status,
        'No source columns were found.' AS Message;

    RETURN;

END;


/* Return unsupported columns and stop */

IF EXISTS
(
    SELECT 1
    FROM @ColumnDefinitions
    WHERE IsSupported = 0
)
BEGIN

    SELECT
        'ERROR' AS Status,
        ColumnID,
        ColumnName,
        SourceType,
        DestinationType,
        Issue

    FROM @ColumnDefinitions

    WHERE IsSupported = 0

    ORDER BY ColumnID;


    SELECT
        'CREATE TABLE NOT GENERATED' AS Status,
        'Resolve unsupported data types before proceeding.'
            AS Message;

    RETURN;

END;


/*================================================================
  6. GENERATE COLUMN DEFINITIONS

  STRING_AGG replaces FOR XML PATH.

  WITHIN GROUP preserves source column order.
================================================================*/

DECLARE @ColumnDDL NVARCHAR(MAX);


SELECT
    @ColumnDDL =
        STRING_AGG
        (
            CAST
            (
                QUOTENAME(ColumnName)
                + N' '
                + DestinationType
                + N' NULL'

                AS NVARCHAR(MAX)
            ),

            N',' + CHAR(13) + CHAR(10) + N'    '

        )
        WITHIN GROUP (ORDER BY ColumnID)

FROM @ColumnDefinitions;


/* Validate generated DDL */

IF @ColumnDDL IS NULL OR LEN(@ColumnDDL) = 0
BEGIN

    SELECT
        'ERROR' AS Status,
        'Unable to generate column definitions.' AS Message;

    RETURN;

END;


/*================================================================
  7. GENERATE FINAL CREATE TABLE COMMAND
================================================================*/

DECLARE @CreateTableSQL NVARCHAR(MAX);


SET @CreateTableSQL =

    N'IF OBJECT_ID(N'''
    + REPLACE
      (
          QUOTENAME(@DestinationSchema)
          + N'.'
          + QUOTENAME(@DestinationTable),

          '''',
          ''''''
      )

    + N''', N''U'') IS NULL'

    + CHAR(13) + CHAR(10)

    + N'BEGIN'

    + CHAR(13) + CHAR(10)

    + N'    CREATE TABLE '

    + QUOTENAME(@DestinationSchema)

    + N'.'

    + QUOTENAME(@DestinationTable)

    + N' ('

    + CHAR(13) + CHAR(10)

    + N'    '

    + @ColumnDDL

    + CHAR(13) + CHAR(10)

    + N'    );'

    + CHAR(13) + CHAR(10)

    + N'END;';


/*================================================================
  8. RETURN GENERATED CREATE TABLE STATEMENT
================================================================*/

SELECT

    'SUCCESS' AS Status,

    @SourceSchema AS SourceSchema,

    @SourceTable AS SourceTable,

    @DestinationSchema AS DestinationSchema,

    @DestinationTable AS DestinationTable,

    (
        SELECT COUNT(*)
        FROM @ColumnDefinitions
    ) AS ColumnCount,

    @CreateTableSQL AS CreateTableSQL;


/*================================================================
  9. RETURN COLUMN MAPPING FOR VALIDATION
================================================================*/

SELECT

    ColumnID,

    ColumnName,

    SourceType,

    DestinationType,

    'NULL' AS DestinationNullability

FROM @ColumnDefinitions

ORDER BY ColumnID;


/*================================================================
  END
================================================================*/
