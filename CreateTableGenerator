DECLARE 
@ENTITY VARCHAR(10)='WCM',
@SourceSchema NVARCHAR(128) = 'dbo_storage',
@SourceTable NVARCHAR(128) = 'CLARITY_EMP',
@DestinationSchema NVARCHAR(128) = 'dbo'
DECLARE @DestinationTable NVARCHAR(128) = @SourceTable,
		@SQL VARCHAR(MAX) ='' 
SET @SQL='
IF EXISTS(SELECT * FROM PROD_CUSTOM.SYS.TABLES WHERE NAME=''DOWNSTREAM_CREATE_TABLE_'+@ENTITY+'_'+@SourceTable+''') BEGIN DROP TABLE PROD_CUSTOM.DBO.DOWNSTREAM_CREATE_TABLE_'+@ENTITY+'_'+@SourceTable+' END 
'
EXEC(@SQL) 


/*==============================================================
  2. VALIDATE SOURCE TABLE
==============================================================*/

IF NOT EXISTS
(
    SELECT 1
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = @SourceSchema
      AND TABLE_NAME = @SourceTable
)
BEGIN
    SELECT
        'ERROR' AS Status,
        'Source table was not found or metadata is inaccessible.'
            AS Message;

    RETURN;
END;


/*==============================================================
  3. GENERATE DESTINATION COLUMN DEFINITIONS
==============================================================*/

DECLARE @ColumnDDL NVARCHAR(MAX);
DECLARE @HasUnsupportedTypes INT;


/*--------------------------------------------------------------
  Check for unsupported data types
--------------------------------------------------------------*/

SELECT
    @HasUnsupportedTypes =
        COUNT(*)
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = @SourceSchema
  AND TABLE_NAME = @SourceTable
  AND LOWER(DATA_TYPE) NOT IN
  (
      'bigint',
      'int',
      'smallint',
      'tinyint',
      'bit',
      'decimal',
      'numeric',
      'money',
      'smallmoney',
      'float',
      'real',
      'date',
      'datetime',
      'datetime2',
      'smalldatetime',
      'datetimeoffset',
      'time',
      'varchar',
      'nvarchar',
      'char',
      'nchar',
      'varbinary',
      'binary',
      'uniqueidentifier',
      'timestamp',
      'rowversion'
  );


/*--------------------------------------------------------------
  Report unsupported types
--------------------------------------------------------------*/

IF @HasUnsupportedTypes > 0
BEGIN

    SELECT
        COLUMN_NAME,
        DATA_TYPE,
        'Unsupported data type' AS Issue
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = @SourceSchema
      AND TABLE_NAME = @SourceTable
      AND LOWER(DATA_TYPE) NOT IN
      (
          'bigint',
          'int',
          'smallint',
          'tinyint',
          'bit',
          'decimal',
          'numeric',
          'money',
          'smallmoney',
          'float',
          'real',
          'date',
          'datetime',
          'datetime2',
          'smalldatetime',
          'datetimeoffset',
          'time',
          'varchar',
          'nvarchar',
          'char',
          'nchar',
          'varbinary',
          'binary',
          'uniqueidentifier',
          'timestamp',
          'rowversion'
      );

    RETURN;

END;


/*==============================================================
  4. BUILD COLUMN DEFINITIONS

  STRING_AGG concatenates the column definitions.
==============================================================*/

SELECT
    @ColumnDDL =
        STRING_AGG
        (
            CAST
            (
                QUOTENAME(COLUMN_NAME)
                + ' '
                +
                CASE LOWER(DATA_TYPE)

                    /* Integer types */

                    WHEN 'bigint' THEN 'BIGINT'
                    WHEN 'int' THEN 'INT'
                    WHEN 'smallint' THEN 'SMALLINT'
                    WHEN 'tinyint' THEN 'TINYINT'
                    WHEN 'bit' THEN 'BIT'


                    /* Decimal */

                    WHEN 'decimal' THEN
                        'DECIMAL('
                        + CAST(NUMERIC_PRECISION AS VARCHAR(10))
                        + ','
                        + CAST(NUMERIC_SCALE AS VARCHAR(10))
                        + ')'

                    WHEN 'numeric' THEN
                        'NUMERIC('
                        + CAST(NUMERIC_PRECISION AS VARCHAR(10))
                        + ','
                        + CAST(NUMERIC_SCALE AS VARCHAR(10))
                        + ')'


                    /* Monetary */

                    WHEN 'money' THEN 'MONEY'
                    WHEN 'smallmoney' THEN 'SMALLMONEY'


                    /* Floating point */

                    WHEN 'float' THEN 'FLOAT'
                    WHEN 'real' THEN 'REAL'


                    /* Date/time */

                    WHEN 'date' THEN 'DATE'
                    WHEN 'datetime' THEN 'DATETIME'
                    WHEN 'smalldatetime' THEN 'SMALLDATETIME'

                    WHEN 'datetime2' THEN
                        'DATETIME2('
                        + CAST(DATETIME_PRECISION AS VARCHAR(10))
                        + ')'

                    WHEN 'datetimeoffset' THEN
                        'DATETIMEOFFSET('
                        + CAST(DATETIME_PRECISION AS VARCHAR(10))
                        + ')'

                    WHEN 'time' THEN
                        'TIME('
                        + CAST(DATETIME_PRECISION AS VARCHAR(10))
                        + ')'


                    /* Character types */

                    WHEN 'varchar' THEN
                        CASE
                            WHEN CHARACTER_MAXIMUM_LENGTH = -1
                                THEN 'VARCHAR(MAX)'
                            ELSE
                                'VARCHAR('
                                + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                                + ')'
                        END

                    WHEN 'nvarchar' THEN
                        CASE
                            WHEN CHARACTER_MAXIMUM_LENGTH = -1
                                THEN 'NVARCHAR(MAX)'
                            ELSE
                                'NVARCHAR('
                                + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                                + ')'
                        END

                    WHEN 'char' THEN
                        'CHAR('
                        + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                        + ')'

                    WHEN 'nchar' THEN
                        'NCHAR('
                        + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                        + ')'


                    /* Binary types */

                    WHEN 'varbinary' THEN
                        CASE
                            WHEN CHARACTER_MAXIMUM_LENGTH = -1
                                THEN 'VARBINARY(MAX)'
                            ELSE
                                'VARBINARY('
                                + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                                + ')'
                        END

                    WHEN 'binary' THEN
                        'BINARY('
                        + CAST(CHARACTER_MAXIMUM_LENGTH AS VARCHAR(10))
                        + ')'


                    /* GUID */

                    WHEN 'uniqueidentifier' THEN 'UNIQUEIDENTIFIER'


                    /* Timestamp/rowversion */

                    WHEN 'timestamp' THEN 'BINARY(8)'
                    WHEN 'rowversion' THEN 'BINARY(8)'


                END
                + ' NULL'

                AS NVARCHAR(MAX)
            ),

            ',' + CHAR(13) + CHAR(10) + '    '

        )
        WITHIN GROUP (ORDER BY ORDINAL_POSITION)

FROM INFORMATION_SCHEMA.COLUMNS

WHERE TABLE_SCHEMA = @SourceSchema
  AND TABLE_NAME = @SourceTable;


/*==============================================================
  5. VALIDATE GENERATED COLUMN DEFINITIONS
==============================================================*/

IF @ColumnDDL IS NULL OR LEN(@ColumnDDL) = 0
BEGIN

    SELECT
        'ERROR' AS Status,
        'Unable to generate column definitions.' AS Message;

    RETURN;

END;


/*==============================================================
  6. GENERATE FINAL CREATE TABLE STATEMENT
==============================================================*/

DECLARE @CreateTableSQL NVARCHAR(MAX);

SET @CreateTableSQL =

    'IF OBJECT_ID(N'''
    + REPLACE
      (
          QUOTENAME(@DestinationSchema)
          + '.'
          + QUOTENAME(@DestinationTable),
          '''',
          ''''''
      )
    + ''', N''U'') IS NULL'

    + CHAR(13) + CHAR(10)

    + 'BEGIN'

    + CHAR(13) + CHAR(10)

    + '    CREATE TABLE '
    + QUOTENAME(@DestinationSchema)
    + '.'
    + QUOTENAME(@DestinationTable)

    + ' ('

    + CHAR(13) + CHAR(10)

    + '    '
    + @ColumnDDL

    + CHAR(13) + CHAR(10)

    + '    );'

    + CHAR(13) + CHAR(10)

    + 'END;';


/*==============================================================
  7. RETURN GENERATED SQL
==============================================================*/

INSERT INTO PROD_CUSTOM.DBO.DOWNSTREAM_CREATE_TABLE_WCM_CLARITY_EMP
SELECT

    'SUCCESS' AS Status,
   
    @SourceSchema AS SourceSchema,
   
    @SourceTable AS SourceTable,
   
    @DestinationSchema AS DestinationSchema,
   
    @DestinationTable AS DestinationTable,
   
    (
        SELECT COUNT(*)
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = @SourceSchema
          AND TABLE_NAME = @SourceTable
    ) AS ColumnCount,
    @CreateTableSQL AS CreateTableSQL
	;


