/* ============================================================
   SYNAPSE SQL -> SQL SERVER CREATE TABLE GENERATOR

   Purpose:
       Read a source table's column metadata from Synapse SQL
       and generate a SQL Server-compatible CREATE TABLE command.

   Design:
       - Preserves column names and ordinal positions
       - Preserves supported data types
       - Preserves string lengths
       - Preserves decimal precision and scale
       - Makes all destination columns NULLABLE
       - Does not copy identity or computed-column properties
       - Converts timestamp/rowversion to binary(8)
       - Stops when it encounters unsupported types

   Output:
       A CREATE TABLE command suitable for an ADF Script activity
       or execution against the SQL Server destination.

   ============================================================ */

DECLARE @SourceSchema       NVARCHAR(128) = 'dbo';
DECLARE @SourceTable        NVARCHAR(128) = 'YourSourceTable';

DECLARE @DestinationSchema  NVARCHAR(128) = 'dbo';
DECLARE @DestinationTable   NVARCHAR(128) = 'YourDestinationTable';


/* ============================================================
   1. FIND SOURCE TABLE
   ============================================================ */

DECLARE @SourceObjectID INT;

SET @SourceObjectID =
    OBJECT_ID(
        QUOTENAME(@SourceSchema) + N'.' + QUOTENAME(@SourceTable)
    );

IF @SourceObjectID IS NULL
BEGIN
    SELECT
        'ERROR' AS Status,
        'Source table was not found.' AS Message,
        @SourceSchema AS SourceSchema,
        @SourceTable AS SourceTable;

    RETURN;
END;


/* ============================================================
   2. BUILD COLUMN METADATA
   ============================================================ */

DECLARE @ColumnDefinitions TABLE
(
    ColumnID       INT,
    ColumnName     NVARCHAR(128),
    SourceType     NVARCHAR(128),
    DestinationType NVARCHAR(500),
    IsSupported    BIT,
    Issue          NVARCHAR(1000)
);


INSERT INTO @ColumnDefinitions
(
    ColumnID,
    ColumnName,
    SourceType,
    DestinationType,
    IsSupported,
    Issue
)
SELECT
    c.column_id,
    c.name,
    bt.name,

    CASE
        /* Integer types */
        WHEN bt.name = 'bigint'
            THEN 'BIGINT'

        WHEN bt.name = 'int'
            THEN 'INT'

        WHEN bt.name = 'smallint'
            THEN 'SMALLINT'

        WHEN bt.name = 'tinyint'
            THEN 'TINYINT'

        WHEN bt.name = 'bit'
            THEN 'BIT'


        /* Decimal / numeric */
        WHEN bt.name IN ('decimal', 'numeric')
             AND c.precision BETWEEN 1 AND 38
             AND c.scale <= c.precision
            THEN
                'DECIMAL('
                + CAST(c.precision AS VARCHAR(10))
                + ','
                + CAST(c.scale AS VARCHAR(10))
                + ')'


        /* Money */
        WHEN bt.name = 'money'
            THEN 'MONEY'

        WHEN bt.name = 'smallmoney'
            THEN 'SMALLMONEY'


        /* Floating point */
        WHEN bt.name = 'float'
            THEN 'FLOAT'

        WHEN bt.name = 'real'
            THEN 'REAL'


        /* Date and time */
        WHEN bt.name = 'date'
            THEN 'DATE'

        WHEN bt.name = 'datetime'
            THEN 'DATETIME'

        WHEN bt.name = 'smalldatetime'
            THEN 'SMALLDATETIME'

        WHEN bt.name = 'datetime2'
            THEN
                'DATETIME2('
                + CAST(c.scale AS VARCHAR(10))
                + ')'

        WHEN bt.name = 'datetimeoffset'
            THEN
                'DATETIMEOFFSET('
                + CAST(c.scale AS VARCHAR(10))
                + ')'

        WHEN bt.name = 'time'
            THEN
                'TIME('
                + CAST(c.scale AS VARCHAR(10))
                + ')'


        /* Character data */
        WHEN bt.name = 'varchar'
             AND c.max_length = -1
            THEN 'VARCHAR(MAX)'

        WHEN bt.name = 'varchar'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'VARCHAR('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'

        WHEN bt.name = 'nvarchar'
             AND c.max_length = -1
            THEN 'NVARCHAR(MAX)'

        WHEN bt.name = 'nvarchar'
             AND c.max_length BETWEEN 2 AND 8000
            THEN
                'NVARCHAR('
                + CAST(c.max_length / 2 AS VARCHAR(10))
                + ')'

        WHEN bt.name = 'char'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'CHAR('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'

        WHEN bt.name = 'nchar'
             AND c.max_length BETWEEN 2 AND 8000
            THEN
                'NCHAR('
                + CAST(c.max_length / 2 AS VARCHAR(10))
                + ')'


        /* Binary data */
        WHEN bt.name = 'varbinary'
             AND c.max_length = -1
            THEN 'VARBINARY(MAX)'

        WHEN bt.name = 'varbinary'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'VARBINARY('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'

        WHEN bt.name = 'binary'
             AND c.max_length BETWEEN 1 AND 8000
            THEN
                'BINARY('
                + CAST(c.max_length AS VARCHAR(10))
                + ')'


        /* GUID */
        WHEN bt.name = 'uniqueidentifier'
            THEN 'UNIQUEIDENTIFIER'


        /* SQL Server rowversion cannot be explicitly inserted.
           Store the source's 8-byte value as binary instead. */
        WHEN bt.name IN ('timestamp', 'rowversion')
            THEN 'BINARY(8)'


        /* Anything else is deliberately rejected */
        ELSE NULL

    END AS DestinationType,


    CASE
        WHEN bt.name IN
        (
            'bigint', 'int', 'smallint', 'tinyint', 'bit',
            'decimal', 'numeric',
            'money', 'smallmoney',
            'float', 'real',
            'date', 'datetime', 'smalldatetime',
            'datetime2', 'datetimeoffset', 'time',
            'varchar', 'nvarchar', 'char', 'nchar',
            'varbinary', 'binary',
            'uniqueidentifier',
            'timestamp', 'rowversion'
        )
        AND
        (
            (
                bt.name IN ('decimal', 'numeric')
                AND
                (
                    c.precision NOT BETWEEN 1 AND 38
                    OR c.scale > c.precision
                )
            )
            OR
            (
                bt.name IN ('varchar', 'nvarchar', 'char', 'nchar',
                            'varbinary', 'binary')
                AND c.max_length = 0
            )
            OR
            (
                bt.name IN ('varchar', 'char', 'varbinary', 'binary')
                AND c.max_length > 8000
            )
            OR
            (
                bt.name IN ('nvarchar', 'nchar')
                AND c.max_length > 8000
            )
        )
        THEN 0

        WHEN bt.name IN
        (
            'bigint', 'int', 'smallint', 'tinyint', 'bit',
            'decimal', 'numeric',
            'money', 'smallmoney',
            'float', 'real',
            'date', 'datetime', 'smalldatetime',
            'datetime2', 'datetimeoffset', 'time',
            'varchar', 'nvarchar', 'char', 'nchar',
            'varbinary', 'binary',
            'uniqueidentifier',
            'timestamp', 'rowversion'
        )
        THEN 1

        ELSE 0
    END AS IsSupported,


    CASE
        WHEN bt.name IS NULL
            THEN 'Unable to identify underlying SQL data type.'

        WHEN bt.name NOT IN
        (
            'bigint', 'int', 'smallint', 'tinyint', 'bit',
            'decimal', 'numeric',
            'money', 'smallmoney',
            'float', 'real',
            'date', 'datetime', 'smalldatetime',
            'datetime2', 'datetimeoffset', 'time',
            'varchar', 'nvarchar', 'char', 'nchar',
            'varbinary', 'binary',
            'uniqueidentifier',
            'timestamp', 'rowversion'
        )
            THEN 'Unsupported or unverified source data type.'

        WHEN bt.name IN ('decimal', 'numeric')
             AND
             (
                 c.precision NOT BETWEEN 1 AND 38
                 OR c.scale > c.precision
             )
            THEN 'Invalid decimal precision or scale.'

        WHEN bt.name IN ('varchar', 'char', 'varbinary', 'binary')
             AND c.max_length > 8000
            THEN 'Source length exceeds SQL Server non-MAX limit.'

        WHEN bt.name IN ('nvarchar', 'nchar')
             AND c.max_length > 8000
            THEN 'Source length exceeds SQL Server non-MAX limit.'

        WHEN c.max_length = 0
             AND bt.name IN
             (
                 'varchar', 'nvarchar', 'char', 'nchar',
                 'varbinary', 'binary'
             )
            THEN 'Invalid or unavailable column length.'

        ELSE NULL
    END AS Issue

FROM sys.columns c

INNER JOIN sys.objects o
    ON c.object_id = o.object_id

LEFT JOIN sys.types bt
    ON c.system_type_id = bt.system_type_id
   AND bt.user_type_id = bt.system_type_id

WHERE c.object_id = @SourceObjectID;


/* ============================================================
   3. VALIDATE METADATA
   ============================================================ */

IF NOT EXISTS (SELECT 1 FROM @ColumnDefinitions)
BEGIN
    SELECT
        'ERROR' AS Status,
        'No columns were found for the source table.' AS Message;

    RETURN;
END;


IF EXISTS
(
    SELECT 1
    FROM @ColumnDefinitions
    WHERE IsSupported = 0
)
BEGIN

    SELECT
        'ERROR' AS Status,
        ColumnID,
        ColumnName,
        SourceType,
        DestinationType,
        Issue
    FROM @ColumnDefinitions
    WHERE IsSupported = 0
    ORDER BY ColumnID;

    SELECT
        'CREATE TABLE NOT GENERATED' AS Status,
        'Resolve the unsupported columns before creating the destination table.'
            AS Message;

    RETURN;

END;


/* ============================================================
   4. GENERATE COLUMN DEFINITIONS
   ============================================================ */

DECLARE @ColumnDDL NVARCHAR(MAX);

SELECT @ColumnDDL =
    STUFF
    (
        (
            SELECT
                CHAR(13) + CHAR(10)
                + N'    ' + QUOTENAME(ColumnName)
                + N' ' + DestinationType
                + N' NULL,'
            FROM @ColumnDefinitions
            ORDER BY ColumnID
            FOR XML PATH(''), TYPE
        ).value('.', 'NVARCHAR(MAX)'),
        1,
        2,
        ''
    );


/* Remove final comma */
SET @ColumnDDL =
    LEFT(@ColumnDDL, LEN(@ColumnDDL) - 1);


/* ============================================================
   5. GENERATE FINAL CREATE TABLE COMMAND
   ============================================================ */

DECLARE @CreateTableSQL NVARCHAR(MAX);

SET @CreateTableSQL =
    N'IF OBJECT_ID(N'''
    + REPLACE(
        QUOTENAME(@DestinationSchema)
        + N'.'
        + QUOTENAME(@DestinationTable),
        '''',
        ''''''
      )
    + N''', N''U'') IS NULL'
    + CHAR(13) + CHAR(10)
    + N'BEGIN'
    + CHAR(13) + CHAR(10)
    + N'    CREATE TABLE '
    + QUOTENAME(@DestinationSchema)
    + N'.'
    + QUOTENAME(@DestinationTable)
    + N' ('
    + CHAR(13) + CHAR(10)
    + @ColumnDDL
    + CHAR(13) + CHAR(10)
    + N'    );'
    + CHAR(13) + CHAR(10)
    + N'END;';


/* ============================================================
   6. RETURN GENERATED SQL
   ============================================================ */

SELECT
    'SUCCESS' AS Status,
    @SourceSchema AS SourceSchema,
    @SourceTable AS SourceTable,
    @DestinationSchema AS DestinationSchema,
    @DestinationTable AS DestinationTable,
    (
        SELECT COUNT(*)
        FROM @ColumnDefinitions
    ) AS ColumnCount,
    @CreateTableSQL AS CreateTableSQL;


/* Optional: return the individual column mappings for auditing */

SELECT
    ColumnID,
    ColumnName,
    SourceType,
    DestinationType,
    'NULL' AS DestinationNullability
FROM @ColumnDefinitions
ORDER BY ColumnID;
