DECLARE  
@LOOPING_TABLE VARCHAR(100)='DOWNSTREAM_WCM_REV_TABLES',
@JOB_NUM VARCHAR(2)=	     '0',
@ENTITY VARCHAR(10)=		'DEL',
@DB VARCHAR(50)=			'PROD',
@SCHEMA varchar(50)=		'dbo_storage',
@TBL VARCHAR(100)=			'CLARITY_EMP'

DECLARE
@CHANGEROWTBL VARCHAR(100)= 'DOWNSTREAM_CHANGED_ROWS_'+@ENTITY+'_'+@JOB_NUM,
@TEMP_TBL_INS VARCHAR(100)= 'DOWNSTREAM_INSERT_'+@ENTITY+'_'+@JOB_NUM,
@TEMP_SQL_TBL VARCHAR(100)='DOWNSTREAM_EXECUTESQL_'+@ENTITY+'_'+@JOB_NUM,
@ETL_END_DATE DATETIME2=          CAST(GETUTCDATE()+1 AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time'  AS DATE),  /*ETL END DATE ALWAYS TOMORROW*/
@ETL_START_DATE DATETIME2=		 NULL, 
@LOOKBACK INT =				 0,
@SQL NVARCHAR(MAX)=			 '',
@SQL2 NVARCHAR(MAX)=			 '',
@SQL3 NVARCHAR(MAX)=			 ''

SET @SQL ='UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET START_TIME =  GETUTCDATE() AT TIME ZONE ''UTC'' AT TIME ZONE ''Eastern Standard Time''   WHERE TABLE_NAME= '''+@TBL+'''' 
EXEC(@SQL)

			/*GET LOOK BACK*/
			SET @SQL =N'SELECT @LOOKBACK = CAST(LOOKBACK_HOURS AS NVARCHAR)  FROM PROD_CUSTOM.DBO.'+@LOOPING_TABLE+ ' WHERE TABLE_NAME='''+@TBL+''''
			EXEC sp_executesql @SQL, N'@LOOKBACK NVARCHAR(MAX) OUTPUT', @LOOKBACK OUTPUT 

			/*SET ETL START DATE*/
			SELECT @ETL_START_DATE = CAST(GETUTCDATE()-(@LOOKBACK/24)  AT TIME ZONE 'UTC' AT TIME ZONE 'Eastern Standard Time'  AS DATE)  

			/*SET JOIN CONDITION*/
SET @SQL =
'	DECLARE @JOINCOND VARCHAR(MAX)=''''
			SELECT @JOINCOND= STRING_AGG(''A.'' + QUOTENAME(C.COLUMN_NAME) + '' = X.'' + QUOTENAME(C.COLUMN_NAME), '' AND '')
			FROM   '+@DB+'.'+@SCHEMA+'.CLARITY_TBL_PK AS A
			JOIN   '+@DB+'.'+@SCHEMA+'.CLARITY_TBL AS B ON A.TABLE_ID = B.TABLE_ID
			JOIN   '+@DB+'.'+@SCHEMA+'.CLARITY_COL AS C ON A.PK_COLUMN_ID = C.COLUMN_ID
			WHERE B.TABLE_NAME = '''+@TBL+''' AND B.TABLE_ID LIKE ''C%''

			/*GET LIST OF PK COLUMNS ***STUFF COMMAND DOES NOT WORK IN Synapse SQL*/
			DECLARE @PKLIST VARCHAR(MAX)
			SELECT @PKLIST=  STRING_AGG(C.COLUMN_NAME, ''","'') WITHIN GROUP (ORDER BY A.LINE ASC) 
			FROM    '+@DB+'.'+@SCHEMA+'.CLARITY_TBL_PK AS A
			JOIN    '+@DB+'.'+@SCHEMA+'.CLARITY_TBL AS B ON A.TABLE_ID = B.TABLE_ID
			JOIN    '+@DB+'.'+@SCHEMA+'.CLARITY_COL AS C ON A.PK_COLUMN_ID = C.COLUMN_ID
			WHERE    B.TABLE_NAME = '''+@TBL+'''   AND B.TABLE_ID LIKE ''C%''

			SET @PKLIST = ''"''+@PKLIST+''"''
			
			/*SET COLUMN LIST AND CONDITION*/
			DECLARE  @COLUMN_LIST VARCHAR(MAX)='''' , @CONDITION VARCHAR(MAX)='''', @SQL NVARCHAR(MAX)=''''
			SET @SQL = ''SELECT @COLUMN_LIST = COLUMN_LIST FROM PROD_CUSTOM.DBO.'+@LOOPING_TABLE+' WHERE Table_Name='''''+@TBL+'''''''
			EXEC sp_executesql @SQL, N''@COLUMN_LIST NVARCHAR(MAX) OUTPUT'', @COLUMN_LIST OUTPUT 
 
			SET @SQL = ''SELECT @CONDITION = ISNULL(CONDITION,'''''''') FROM PROD_CUSTOM.DBO.'+@LOOPING_TABLE+' WHERE Table_Name='''''+@TBL+'''''''
			EXEC sp_executesql @SQL, N''@CONDITION NVARCHAR(MAX) OUTPUT'', @CONDITION OUTPUT 


SET @SQL =''UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET START_DROP_TEMP_TIME = GETUTCDATE() AT TIME ZONE ''''UTC'''' AT TIME ZONE ''''Eastern Standard Time'''' WHERE TABLE_NAME= '''''+@TBL+''''''' EXEC(@SQL)
			--DROP CHANGE ROW TABLE
			SET @SQL =''IF EXISTS(SELECT * FROM PROD_CUSTOM.SYS.TABLES WHERE NAME='''''+@CHANGEROWTBL+''''') BEGIN DROP TABLE PROD_CUSTOM.DBO.'+@CHANGEROWTBL+' END ''
			EXEC(@SQL)


			--DROP DOWNSTREAM INSERT TABLE
			SET @SQL =''IF EXISTS(SELECT * FROM PROD_CUSTOM.SYS.TABLES WHERE NAME='''''+@TEMP_TBL_INS+''''') BEGIN DROP TABLE PROD_CUSTOM.DBO.'+@TEMP_TBL_INS+' END ''
			EXEC(@SQL)
SET @SQL =''UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET END_DROP_TEMP_TIME = GETUTCDATE() AT TIME ZONE ''''UTC'''' AT TIME ZONE ''''Eastern Standard Time''''  WHERE TABLE_NAME= '''''+@TBL+''''''' EXEC(@SQL)

SET @SQL =''UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET START_SP_TIME =  GETUTCDATE() AT TIME ZONE ''''UTC'''' AT TIME ZONE ''''Eastern Standard Time''''  WHERE TABLE_NAME= '''''+@TBL+''''''' EXEC(@SQL)
			
			DECLARE @CRT VARCHAR(100) = ''DBO.' +@CHANGEROWTBL+'''	
					


	--CREATE DCHANGED ROWS TABLE (DELETE TABLE)
			EXEC PROD.DBO.ESP_GET_CHANGED_ROWS '''+@TBL+''',@PKLIST,'+''''+cast(@ETL_START_DATE as nvarchar(100))+''''+','+''''+cast(@ETL_END_DATE as nvarchar(100))+''''+', @CRT
			


SET @SQL =''UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET END_SP_TIME = GETUTCDATE() AT TIME ZONE ''''UTC'''' AT TIME ZONE ''''Eastern Standard Time''''   WHERE TABLE_NAME=  '''''+@TBL+''''''' EXEC(@SQL)


SET @SQL =''UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET START_CREATETEMP_TIME = GETUTCDATE() AT TIME ZONE ''''UTC'''' AT TIME ZONE ''''Eastern Standard Time''''   WHERE TABLE_NAME=  '''''+@TBL+''''''' EXEC(@SQL)
'

SET @SQL2 =
'	
		
--CREATE INSERT TEMP TABLE 
			SET @SQL=''SELECT ''+@COLUMN_LIST+'' 
			INTO PROD_CUSTOM.DBO.'+@TEMP_TBL_INS+' 
			FROM '+@DB+'.'+@SCHEMA+'.'+@TBL+' A WHERE 1=1
			AND EXISTS( SELECT * FROM PROD_CUSTOM.DBO.'+@CHANGEROWTBL+' X WHERE ''+ @JOINCOND +'') /*IS A CHANGED ROW*/
			''+@CONDITION+''/*ADD SA CONDTION IF NEEDED*/ ''
			EXEC(@SQL)

--CREATE EXECUTE SQL TABLE
			SET @SQL =''IF EXISTS(SELECT * FROM PROD_CUSTOM.SYS.TABLES WHERE NAME='''''+@TEMP_SQL_TBL+''''') BEGIN DROP TABLE PROD_CUSTOM.DBO.'+@TEMP_SQL_TBL+' END ''
			EXEC(@SQL)

			--DELETE COMMAND
			SELECT ''DELETE A from '+@TBL+' A WHERE EXISTS(SELECT * FROM dbo.'+@CHANGEROWTBL+' X WHERE ''+ @JOINCOND +''  ) '' AS SQLCOMMAND INTO PROD_CUSTOM.DBO.'+@TEMP_SQL_TBL+'

			--INSERT COMMAND
			INSERT INTO PROD_CUSTOM.DBO.'+@TEMP_SQL_TBL+'
			SELECT ''INSERT INTO '+@TBL+' SELECT * FROM  '+@TEMP_TBL_INS+' A WHERE NOT EXISTS(SELECT * FROM '+@TBL+' X WHERE ''+ @JOINCOND +'' ) ''


SET @SQL =''UPDATE  PROD_CUSTOM.DBO.'+ @LOOPING_TABLE +' SET END_CREATETEMP_TIME = GETUTCDATE() AT TIME ZONE ''''UTC'''' AT TIME ZONE ''''Eastern Standard Time''''   WHERE TABLE_NAME= '''''+@TBL+''''''' EXEC(@SQL)



